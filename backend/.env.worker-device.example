# Worker device — jalankan `python worker.py` di mesin dengan GPU
API_URL=https://your-server.example/api
WORKER_TOKEN=ganti-dengan-secret-panjang-sama
WORKER_ID=pc-kantor
WORKER_POLL_SEC=5
WORKER_HEARTBEAT_SEC=30

# Gemini (analyze + caption) — pipeline jalan di DEVICE ini
GOOGLE_API_KEY=your-gemini-key
ANALYZE_MODEL=gemini-flash-latest
ANALYZE_MODEL_FALLBACK=gemini-3.6-flash
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
MAX_CONCURRENT_JOBS=1