GOOGLE_API_KEY=
ANALYZE_MODEL=gemini-flash-latest
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_INITIAL_PROMPT=
# Kalau 2 job transcribe bareng OOM di GPU 4GB → set MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_JOBS=2
CONFIDENCE_THRESHOLD=0.6
MIN_HOLD_SEC=1.2
VIDEO_DOWNLOAD_RESOLUTION=720
STORAGE_RETENTION_DAYS=14
CHUNK_DURATION_MIN=20
CHUNK_OVERLAP_MIN=2
CLIP_ALIGN_SENTENCE=true
LOG_LEVEL=INFO
