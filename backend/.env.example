GOOGLE_API_KEY=
ANALYZE_MODEL=gemini-flash-latest
ANALYZE_MODEL_FALLBACK=gemini-3.6-flash
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_INITIAL_PROMPT=
# Kalau 2 job transcribe bareng OOM di GPU 4GB, set MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_JOBS=2
CONFIDENCE_THRESHOLD=0.6
MIN_HOLD_SEC=1.2
VIDEO_DOWNLOAD_RESOLUTION=720
STORAGE_RETENTION_DAYS=14
CHUNK_DURATION_MIN=20
CHUNK_OVERLAP_MIN=2
CLIP_ALIGN_SENTENCE=true
REFRAME_ZOOM_MIN=1.15
REFRAME_ZOOM_MAX=2.0
REFRAME_ZOOM_FIT=0.6
REFRAME_HEAD_BIAS=0.22
REFRAME_ZOOM_IDLE=1.05
REFRAME_ZOOM_EASE=0.04
REFRAME_ZOOM_DEADBAND=0.05
# Tracking: inference tiap frame ke-N (3 = 3x lebih cepat, box carry-forward),
# imgsz 320 (4x murah FLOPs, tanpa menambah frame-miss), hasil di-cache ke
# data/tracks/ (A/B tuning gak re-track)
REFRAME_TRACK_STEP=3
REFRAME_TRACK_CACHE=true
REFRAME_TRACK_IMGSZ=320
LOG_LEVEL=INFO