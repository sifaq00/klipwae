# Server (HF Spaces / VPS) — API ringan + queue
WORKER_QUEUE=true
WORKER_TOKEN=ganti-dengan-secret-panjang

# Cloudflare R2 (bucket "klipwae" — sudah dibuat)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=klipwae
# Custom domain / r2.dev URL bucket — public read utk UI
R2_PUBLIC_URL=https://your-bucket-domain.example

